; ==================== 全局参数 ====================
enable_rule_generator=true
overwrite_original_rules=true
; 过滤机场官网、返利等非节点条目。
exclude_remarks=(官网|产品|海外|返利|公益|过期|无效|注册|回国|免费|体验|广告位|○|com|link|20x|20倍|5x|3x|3倍|5倍)

; 自定义基础模板（可选）。不设置时 subconverter-ng 使用内置默认：
; mixed-port 7890、fake-ip、223.5.5.5/119.29.29.29 DNS。
;clash_rule_base=https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/GeneralClashConfig.yml

;luck
